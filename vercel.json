{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partnership/index.html",
      "destination": "/partnership",
      "permanent": true
    },
    {
      "source": "/partner",
      "destination": "/partnership",
      "permanent": true
    },
    {
      "source": "/partner/",
      "destination": "/partnership",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/partnership",
      "destination": "/partnership.html"
    }
  ]
}
