{
  "name": "@apps/app-shell",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@apps/booking-engine": "workspace:*",
    "@craco/craco": "^7.1.0",
    "@packages/trem-auth-core": "workspace:*",
    "@packages/trem-events": "workspace:*",
    "@packages/trem-modals": "workspace:*",
    "@packages/trem-runtime": "workspace:*",
    "@packages/trem-session": "workspace:*",
    "@packages/trem-support-contracts": "workspace:*",
    "@packages/trem-ui": "workspace:*",
    "@packages/trem-utils": "workspace:*",
    "axios": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "sass": "^1.86.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "prebuild": "node ../../scripts/sync-favicons.mjs app-shell",
    "dev": "cross-env BROWSER=none PORT=3006 DISABLE_ESLINT_PLUGIN=true craco start",
    "start": "cross-env BROWSER=none PORT=3006 DISABLE_ESLINT_PLUGIN=true craco start",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true craco build",
    "test": "craco test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
