# Vercel/frontend build variables for App Shell
PORT=3006
REACT_APP_PORTAL_ENV=production
REACT_APP_BACKEND_URL=https://api.travelstrem.com
REACT_APP_API_URL=https://api.travelstrem.com/api
REACT_APP_REALTIME_ENABLED=true
REACT_APP_REALTIME_URL=https://api.travelstrem.com
REACT_APP_REALTIME_PATH=/socket.io
REACT_APP_AUTH_APP_URL=https://auth.travelstrem.com
REACT_APP_SHELL_URL=https://app.travelstrem.com
REACT_APP_TREVIO_URL=https://trevio.travelstrem.com
REACT_APP_TREVIO_REMOTE_ENTRY=https://trevio.travelstrem.com/remoteEntry.js
REACT_APP_TREVISTA_URL=https://trevista.travelstrem.com
REACT_APP_TREVISTA_REMOTE_ENTRY=https://trevista.travelstrem.com/remoteEntry.js
REACT_APP_THEME_COOKIE_DOMAIN=.travelstrem.com

# Keep false in Vercel unless you intentionally need runtime-like local overrides.
REACT_APP_ALLOW_ENV_OVERRIDES=false
