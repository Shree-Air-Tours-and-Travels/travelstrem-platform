{
  "name": "@apps/trevio",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@packages/trem-auth-core": "workspace:*",
    "@packages/trem-environment": "workspace:*",
    "@packages/trem-events": "workspace:*",
    "@packages/trem-modals": "workspace:*",
    "@packages/trem-runtime": "workspace:*",
    "@packages/trem-session": "workspace:*",
    "@packages/trem-ui": "workspace:*",
    "@packages/trem-utils": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "sass": "^1.86.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "prebuild": "node ../../scripts/sync-favicons.mjs trevio-remote",
    "dev": "cross-env PUBLIC_URL=/ PORT=3005 DISABLE_ESLINT_PLUGIN=true craco start",
    "start": "cross-env PUBLIC_URL=/ PORT=3005 DISABLE_ESLINT_PLUGIN=true craco start",
    "build": "cross-env PUBLIC_URL=/ DISABLE_ESLINT_PLUGIN=true craco build",
    "test": "craco test --watchAll=false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
