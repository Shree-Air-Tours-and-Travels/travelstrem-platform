{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    { "source": "/remoteEntry.js", "destination": "/remoteEntry.js" },
    { "source": "/remoteEntry.js.map", "destination": "/remoteEntry.js.map" },
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/favicon-dark.png", "destination": "/favicon-dark.png" },
    { "source": "/asset-manifest.json", "destination": "/asset-manifest.json" },
    { "source": "/manifest.json", "destination": "/manifest.json" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/remoteEntry.js",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
