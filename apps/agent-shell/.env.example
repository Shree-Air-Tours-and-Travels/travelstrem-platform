# Vercel/frontend build variables for Agent/Partner Shell
PORT=3004
REACT_APP_PORTAL_ENV=production
REACT_APP_BACKEND_URL=https://api.example.com
REACT_APP_API_URL=https://api.example.com/api
REACT_APP_REALTIME_URL=https://api.example.com
REACT_APP_REALTIME_PATH=/socket.io
REACT_APP_AUTH_APP_URL=https://auth.example.com
REACT_APP_PARTNER_SHELL_URL=https://partner.example.com
REACT_APP_SHELL_URL=https://app.example.com
REACT_APP_TREVISTA_URL=https://trevista.example.com
REACT_APP_TREVIO_URL=https://trevio.example.com
REACT_APP_THEME_COOKIE_DOMAIN=.example.com

# Keep false in Vercel unless you intentionally need runtime-like local overrides.
REACT_APP_ALLOW_ENV_OVERRIDES=false
