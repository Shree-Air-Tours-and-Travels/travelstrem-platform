{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    { "source": "/static/:path*", "destination": "/static/:path*" },
    { "source": "/asset-manifest.json", "destination": "/asset-manifest.json" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
