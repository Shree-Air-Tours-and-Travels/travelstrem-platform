# Runtime
# Use NODE_ENV=test for a deployed test/staging backend that should behave like production
# while using separate non-production credentials.
NODE_ENV=production
PORT=5000
APP_NAME=TravelsTrem
BASE_URL=https://api.travelstrem.com
FRONTENDS=["https://trevista.travelstrem.com","https://admin.travelstrem.com","https://auth.travelstrem.com","https://partner.travelstrem.com","https://trevio.travelstrem.com","https://trehub.travelstrem.com","https://app.travelstrem.com","https://booking.travelstrem.com"]
CORS_ALLOWED_DOMAIN_SUFFIXES=
PORTAL_ENV=production

# Application URLs
TREVIO_URL=https://trevio.travelstrem.com
TREVISTA_URL=https://trevista.travelstrem.com
TREHUB_URL=https://trehub.travelstrem.com
SHELL_URL=https://app.travelstrem.com
AUTH_APP_URL=https://auth.travelstrem.com
PARTNER_URL=https://partner.travelstrem.com
ADMIN_URL=https://admin.travelstrem.com
ADMIN_REMOTE_URL=https://admin.travelstrem.com

# Brand and support
COMPANY_NAME=TravelsTrem
COMPANY_TAGLINE=Your Journey, Our Passion
SUPPORT_EMAIL=support@travelstrem.com
ENQUIRY_EMAIL=support@travelstrem.com
SUPPORT_PHONE=
DEFAULT_TOUR_IMAGE=
AGENT_EMAIL_DOMAIN=travelstrem.com
INVITATION_TTL_HOURS=48
WHATSAPP_CHANNEL_NAME=Trevio
WHATSAPP_CHANNEL_URL=

# Required database and security
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_CREATION_SECRET=
PII_ENCRYPTION_KEY=
AUTH_COOKIE_DOMAIN=.travelstrem.com
AUTH_COOKIE_SAMESITE=none
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PHONE=
MASTER_ADMIN_PIN=

# Google OpenID Connect (enable only after all three values are configured)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.travelstrem.com/api/auth/google/callback
OAUTH_TRANSACTION_TTL_SECONDS=600

# Google Places (New). Backend-only key used by the shared location typeahead.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_BASE_URL=https://places.googleapis.com/v1

# Mobile authentication. Hidden in production/test even if this is true.
MOBILE_AUTH_ENABLED=false
MOBILE_AUTH_PROVIDER=
MOBILE_AUTH_DEV_MODE=false
MOBILE_AUTH_TEST_OTP=
MOBILE_OTP_EXPIRY_SECONDS=300
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60

# Services
# Required for authentication, sessions, CSRF and cache. Supports redis:// and rediss://.
REDIS_URL=
# Keep false for a single backend instance. Enable only for horizontal Socket.IO fan-out.
ENABLE_REDIS_SOCKET_ADAPTER=false

# FLIGHT_UNAVAILABLE, PROVIDER_TIMEOUT or BOOKING_FAILED.
# Development/test only: PRICE_CHANGED, SEAT_UNAVAILABLE, FARE_UNAVAILABLE,
MOCK_FLIGHT_FORCE_ERROR=
# Provider-neutral Flights domain. Mock mode requires no external API credentials.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=hotelbeds
HOTEL_PROVIDERS=hotelbeds,stayingapi,trekko
HOTEL_PROVIDER_RESULT_LIMIT=40
MOCK_FLIGHT_MIN_LATENCY_MS=300
MOCK_FLIGHT_MAX_LATENCY_MS=1200

# Backend-owned display currency. Providers returning another currency are
# normalized before hotel prices enter the Financial Engine or frontend contract.
DEFAULT_DISPLAY_CURRENCY=INR
CURRENCY_EXCHANGE_BASE_URL=https://api.frankfurter.dev/v2
CURRENCY_EXCHANGE_TIMEOUT_MS=10000
CURRENCY_EXCHANGE_CACHE_TTL_MS=3600000

# Hotelbeds Booking API. Keep credentials empty in committed files.
HOTEL_HOTELBEDS_ALIAS=
HOTEL_HOTELBEDS_ENVIRONMENT=sandbox
HOTEL_HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com
HOTEL_HOTELBEDS_REQUEST_TIMEOUT_MS=45000
HOTEL_HOTELBEDS_API_KEY=
HOTEL_HOTELBEDS_API_SECRET=
HOTEL_HOTELBEDS_MTLS_CERT_PATH=
HOTEL_HOTELBEDS_MTLS_KEY_PATH=
HOTEL_HOTELBEDS_MTLS_PASSPHRASE=

HOTEL_HOTELBEDS_RATE_LIMIT_REQUESTS=8
HOTEL_HOTELBEDS_RATE_LIMIT_WINDOW_SECONDS=4
HOTEL_HOTELBEDS_THROTTLE_INTERVAL_MS=0
HOTEL_HOTELBEDS_THROTTLE_RETRY_LIMIT=0
HOTEL_HOTELBEDS_QUOTA_MAX=50
HOTEL_HOTELBEDS_QUOTA_RESET_SECONDS=86400
HOTEL_HOTELBEDS_RESULT_LIMIT=40
HOTEL_HOTELBEDS_MAX_RATES_PER_ROOM=3

# StayingAPI. Only the bearer API key is required.
HOTEL_STAYINGAPI_ALIAS=stayingapi
HOTEL_STAYINGAPI_ENVIRONMENT=sandbox
HOTEL_STAYINGAPI_BASE_URL=https://api.stayingapi.com/v1
HOTEL_STAYINGAPI_REQUEST_TIMEOUT_MS=30000
HOTEL_STAYINGAPI_ASYNC_TIMEOUT_MS=240000
HOTEL_STAYINGAPI_API_KEY=
HOTEL_STAYINGAPI_API_SECRET=
HOTEL_STAYINGAPI_PLATFORMS=booking,google
HOTEL_STAYINGAPI_RESULT_LIMIT=40
HOTEL_STAYINGAPI_RATE_LIMIT_REQUESTS=10
HOTEL_STAYINGAPI_RATE_LIMIT_WINDOW_SECONDS=60
HOTEL_STAYINGAPI_THROTTLE_INTERVAL_MS=0
HOTEL_STAYINGAPI_THROTTLE_RETRY_LIMIT=2
HOTEL_STAYINGAPI_QUOTA_MAX=0
HOTEL_STAYINGAPI_QUOTA_RESET_SECONDS=86400

# Trekko Hotel API. API key and secret are both required.
HOTEL_TREKKO_ALIAS=trekko
HOTEL_TREKKO_ENVIRONMENT=sandbox
HOTEL_TREKKO_BASE_URL=https://api.trekko.co/core/sandbox
HOTEL_TREKKO_REQUEST_TIMEOUT_MS=45000
HOTEL_TREKKO_API_KEY=
HOTEL_TREKKO_API_SECRET=
HOTEL_TREKKO_RESULT_LIMIT=8
HOTEL_TREKKO_RATE_LIMIT_REQUESTS=10
HOTEL_TREKKO_RATE_LIMIT_WINDOW_SECONDS=1
HOTEL_TREKKO_THROTTLE_INTERVAL_MS=0
HOTEL_TREKKO_THROTTLE_RETRY_LIMIT=2
HOTEL_TREKKO_QUOTA_MAX=0
HOTEL_TREKKO_QUOTA_RESET_SECONDS=86400


CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TravelsTREM
SMTP_FROM_EMAIL=
AGENT_WEBHOOK_URL=
DASHBOARD_EXTERNAL_NAV_ORIGINS=

# Financial Engine / Razorpay
# Use rzp_test_* credentials outside production. Store real values in the
# deployment secret manager; never expose the two secret values to a frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=15000

# Features
ENABLE_EMAILS=false
ENABLE_DEBUG_LOGS=false
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_MS=30000
DEV_OTP_BYPASS=false
RATE_WINDOW_MS=60000
RATE_MAX=60
DEV_DELAY_MS=0
TREVIO_GST_PERCENT=0
TREVIO_COUPON_CODE=
TREVIO_COUPON_DISCOUNT_PERCENT=0
TREVIO_LOW_SEAT_THRESHOLD=3

# Realtime
# Socket.IO uses the same HTTP server and same auth cookies/JWT session.
# Optional: set false to disable sockets. HTTP/API journeys continue normally.
# Frontends should set REACT_APP_REALTIME_URL to BASE_URL and
# REACT_APP_REALTIME_PATH to REALTIME_PATH.
REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_MAX_HTTP_BUFFER_SIZE=65536
REALTIME_MAX_SUBSCRIPTIONS_PER_SOCKET=100
REALTIME_SUBSCRIBE_RATE_MAX=30
REALTIME_SUBSCRIBE_RATE_WINDOW_SEC=60

# Cloudflare R2 Object Storage (optional - falls back to local disk when omitted)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=travelstrem-documents
R2_ENDPOINT=
R2_SIGNED_URL_EXPIRY_SECONDS=600
