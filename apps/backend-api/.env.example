# Runtime
NODE_ENV=development
USE_DOTENV=true
PORT=5000
APP_NAME=TravelsTrem
BASE_URL=http://localhost:5000
FRONTENDS=["http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004","http://localhost:3005","http://localhost:3006","http://localhost:3007"]
CORS_ALLOWED_DOMAIN_SUFFIXES=

# Application URLs
TREVIO_URL=http://localhost:3005
TREVISTA_URL=http://localhost:3001
SHELL_URL=http://localhost:3006
BOOKING_ENGINE_URL=http://localhost:3007
AUTH_APP_URL=http://localhost:3003
PARTNER_URL=http://localhost:3004
ADMIN_URL=http://localhost:3002
ADMIN_REMOTE_URL=http://localhost:3002

# Brand and support
COMPANY_NAME=TravelsTrem
COMPANY_TAGLINE=Your Journey, Our Passion
SUPPORT_EMAIL=support@example.com
ENQUIRY_EMAIL=enquiries@example.com
SUPPORT_PHONE=
DEFAULT_TOUR_IMAGE=
AGENT_EMAIL_DOMAIN=example.com
INVITATION_TTL_HOURS=48
DEMO_SEED_PASSWORD=
WHATSAPP_CHANNEL_NAME=Trevio
WHATSAPP_CHANNEL_URL=

# Database and security
MONGO_URI=
MONGO_URI_DEV=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_CREATION_SECRET=
PII_ENCRYPTION_KEY=
AUTH_COOKIE_DOMAIN=
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PHONE=
# Required in production. Development defaults to 123456 when omitted.
MASTER_ADMIN_PIN=

# Google OpenID Connect (enable only after all three values are configured)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
OAUTH_TRANSACTION_TTL_SECONDS=600

# Mobile authentication. Leave provider blank until an SMS adapter is added.
MOBILE_AUTH_ENABLED=true
MOBILE_AUTH_PROVIDER=
MOBILE_AUTH_DEV_MODE=false
MOBILE_AUTH_TEST_OTP=
MOBILE_OTP_EXPIRY_SECONDS=300
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60

# Services
REDIS_URL=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akshat.goyal@travelstrem.com
SMTP_PASS=
SMTP_FROM_NAME=TravelsTREM
SMTP_FROM_EMAIL=akshat.goyal@travelstrem.com
AGENT_WEBHOOK_URL=
GOOGLE_API_KEY=

# Features
ENABLE_EMAILS=false
ENABLE_DEBUG_LOGS=false
OTP_TTL_MS=900000
DEV_OTP_BYPASS=false
RATE_WINDOW_MS=60000
RATE_MAX=1000
DEV_DELAY_MS=3000
TREVIO_TRAVEL_PROTECTION_PRICE=2499
TREVIO_SINGLE_ROOM_UPGRADE_PRICE=4800
TREVIO_GST_PERCENT=0
TREVIO_COUPON_CODE=
TREVIO_COUPON_DISCOUNT_PERCENT=0
TREVIO_LOW_SEAT_THRESHOLD=3
