# Runtime
# Use NODE_ENV=test for a deployed test/staging backend that should behave like production
# while using separate non-production credentials.
NODE_ENV=production
PORT=5000
APP_NAME=TravelsTrem
BASE_URL=https://api.example.com
FRONTENDS=["https://trevista.example.com","https://admin.example.com","https://auth.example.com","https://partner.example.com","https://trevio.example.com","https://app.example.com","https://booking.example.com"]
CORS_ALLOWED_DOMAIN_SUFFIXES=
PORTAL_ENV=production

# Application URLs
TREVIO_URL=https://trevio.example.com
TREVISTA_URL=https://trevista.example.com
SHELL_URL=https://app.example.com
AUTH_APP_URL=https://auth.example.com
PARTNER_URL=https://partner.example.com
ADMIN_URL=https://admin.example.com
ADMIN_REMOTE_URL=https://admin.example.com

# Brand and support
COMPANY_NAME=TravelsTrem
COMPANY_TAGLINE=Your Journey, Our Passion
SUPPORT_EMAIL=support@example.com
ENQUIRY_EMAIL=enquiries@example.com
SUPPORT_PHONE=
DEFAULT_TOUR_IMAGE=
AGENT_EMAIL_DOMAIN=example.com
INVITATION_TTL_HOURS=48
WHATSAPP_CHANNEL_NAME=Trevio
WHATSAPP_CHANNEL_URL=

# Required database and security
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_CREATION_SECRET=
PII_ENCRYPTION_KEY=
AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_SAMESITE=none
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PHONE=
MASTER_ADMIN_PIN=

# Google OpenID Connect (enable only after all three values are configured)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
OAUTH_TRANSACTION_TTL_SECONDS=600

# Mobile authentication. Hidden in production/test even if this is true.
MOBILE_AUTH_ENABLED=false
MOBILE_AUTH_PROVIDER=
MOBILE_AUTH_DEV_MODE=false
MOBILE_AUTH_TEST_OTP=
MOBILE_OTP_EXPIRY_SECONDS=300
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60

# Services
# Optional for realtime fan-out across multiple backend instances. A single
# Render instance works without Redis; set this before horizontal scaling.
REDIS_URL=
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TravelsTREM
SMTP_FROM_EMAIL=
AGENT_WEBHOOK_URL=
DASHBOARD_EXTERNAL_NAV_ORIGINS=

# Financial Engine / Razorpay
# Use rzp_test_* credentials outside production. Store real values in the
# deployment secret manager; never expose the two secret values to a frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=15000
BOOKING_QUOTE_TTL_MINUTES=20

# Features
ENABLE_EMAILS=false
ENABLE_DEBUG_LOGS=false
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_MS=30000
DEV_OTP_BYPASS=false
RATE_WINDOW_MS=60000
RATE_MAX=60
DEV_DELAY_MS=0
TREVIO_GST_PERCENT=0
TREVIO_COUPON_CODE=
TREVIO_COUPON_DISCOUNT_PERCENT=0
TREVIO_LOW_SEAT_THRESHOLD=3

# Realtime
# Socket.IO uses the same HTTP server and same auth cookies/JWT session.
# Optional: set false to disable sockets. HTTP/API journeys continue normally.
# Frontends should set REACT_APP_REALTIME_URL to BASE_URL and
# REACT_APP_REALTIME_PATH to REALTIME_PATH.
REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_MAX_HTTP_BUFFER_SIZE=65536
REALTIME_MAX_SUBSCRIPTIONS_PER_SOCKET=100
REALTIME_SUBSCRIBE_RATE_MAX=30
REALTIME_SUBSCRIBE_RATE_WINDOW_SEC=60

# Cloudflare R2 Object Storage (optional - falls back to local disk when omitted)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=travelstrem-documents
R2_ENDPOINT=
R2_SIGNED_URL_EXPIRY_SECONDS=600
