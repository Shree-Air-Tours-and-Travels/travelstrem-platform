# Test/staging backend runtime. This file is ignored by Git.
# Behavior is production-like when NODE_ENV=test.
NODE_ENV=test
USE_DOTENV=true
PORT=5000
APP_NAME=TravelsTrem
BASE_URL=https://api-test.example.com
FRONTENDS=["https://app-test.example.com","https://trevista-test.example.com","https://auth-test.example.com","https://admin-test.example.com","https://partner-test.example.com","https://booking-test.example.com"]
CORS_ALLOWED_DOMAIN_SUFFIXES=
PORTAL_ENV=production

TREVISTA_URL=https://trevista-test.example.com
SHELL_URL=https://app-test.example.com
AUTH_APP_URL=https://auth-test.example.com
PARTNER_URL=https://partner-test.example.com
ADMIN_URL=https://admin-test.example.com
ADMIN_REMOTE_URL=https://admin-test.example.com

COMPANY_NAME=TravelsTrem
COMPANY_TAGLINE=Your Journey, Our Passion
SUPPORT_EMAIL=support@example.com
ENQUIRY_EMAIL=enquiries@example.com
SUPPORT_PHONE=
DEFAULT_TOUR_IMAGE=
AGENT_EMAIL_DOMAIN=example.com
INVITATION_TTL_HOURS=48
WHATSAPP_CHANNEL_NAME=Trevio
WHATSAPP_CHANNEL_URL=

MONGO_URI=mongodb://localhost:27017/travelstrem-test
JWT_ACCESS_SECRET=test_env_access_secret_change_me
JWT_REFRESH_SECRET=test_env_refresh_secret_change_me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ADMIN_CREATION_SECRET=test_env_admin_creation_secret_change_me
PII_ENCRYPTION_KEY=
AUTH_COOKIE_DOMAIN=.example.com
AUTH_COOKIE_SAMESITE=none
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PHONE=
MASTER_ADMIN_PIN=123456

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api-test.example.com/api/auth/google/callback
OAUTH_TRANSACTION_TTL_SECONDS=600

MOBILE_AUTH_ENABLED=false
MOBILE_AUTH_PROVIDER=
MOBILE_AUTH_DEV_MODE=false
MOBILE_AUTH_TEST_OTP=
MOBILE_OTP_EXPIRY_SECONDS=300
MOBILE_OTP_MAX_ATTEMPTS=5
MOBILE_OTP_RESEND_COOLDOWN_SECONDS=60

# Required for authentication, sessions, CSRF and cache. Supports redis:// and rediss://.
REDIS_URL=
# Keep false for a single backend instance. Enable only for horizontal Socket.IO fan-out.
ENABLE_REDIS_SOCKET_ADAPTER=false
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TravelsTREM
SMTP_FROM_EMAIL=
AGENT_WEBHOOK_URL=
DASHBOARD_EXTERNAL_NAV_ORIGINS=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_MS=15000
BOOKING_QUOTE_TTL_MINUTES=20

ENABLE_EMAILS=false
ENABLE_DEBUG_LOGS=false
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_MS=30000
DEV_OTP_BYPASS=false
RATE_WINDOW_MS=60000
RATE_MAX=60
DEV_DELAY_MS=0
TREVIO_GST_PERCENT=0
TREVIO_COUPON_CODE=
TREVIO_COUPON_DISCOUNT_PERCENT=0
TREVIO_LOW_SEAT_THRESHOLD=3

# Socket.IO uses the same HTTP server and same auth cookies/JWT session.
# Frontends should set REACT_APP_REALTIME_URL to BASE_URL and
# REACT_APP_REALTIME_PATH to REALTIME_PATH.
REALTIME_ENABLED=true
REALTIME_PATH=/socket.io
REALTIME_PING_INTERVAL_MS=25000
REALTIME_PING_TIMEOUT_MS=20000
REALTIME_MAX_HTTP_BUFFER_SIZE=65536
REALTIME_MAX_SUBSCRIPTIONS_PER_SOCKET=100
REALTIME_SUBSCRIBE_RATE_MAX=30
REALTIME_SUBSCRIBE_RATE_WINDOW_SEC=60

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=travelstrem-documents
R2_ENDPOINT=
R2_SIGNED_URL_EXPIRY_SECONDS=600
