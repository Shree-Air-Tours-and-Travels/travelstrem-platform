# =============================================================================
# Production environment , set each value before deploying
# Copy to your server and fill in the real secrets
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=production
APP_NAME=TravelsTrem
BASE_URL=https://api.travelstrem.com
FRONTENDS=["https://trevio.travelstrem.com","https://trevista.travelstrem.com","https://dashboard.travelstrem.com","https://booking.travelstrem.com","https://auth.travelstrem.com","https://admin.travelstrem.com","https://www.travelstrem.com","https://travelstrem.com"]
CORS_ALLOWED_DOMAIN_SUFFIXES=.travelstrem.com
TREVIO_URL=https://trevio.travelstrem.com
TREVISTA_URL=https://trevista.travelstrem.com
DASHBOARD_URL=https://dashboard.travelstrem.com
BOOKING_ENGINE_URL=https://booking.travelstrem.com
AUTH_APP_URL=https://auth.travelstrem.com
ADMIN_URL=https://admin.travelstrem.com
ADMIN_REMOTE_URL=https://admin.travelstrem.com

# --- Brand / support ---------------------------------------------------------
COMPANY_NAME=TravelsTrem
COMPANY_TAGLINE=Your Journey, Our Passion
SUPPORT_EMAIL=support@travelstrem.com
SUPPORT_PHONE=+919057635580
DEFAULT_TOUR_IMAGE=https://res.cloudinary.com/dofxshf3z/image/upload/v1779131576/tour-img01_tljj0m.jpg
AGENT_EMAIL_DOMAIN=travelstrem.com
MASTER_ADMIN_EMAIL=akshat.goyal@travelstrem.com
MASTER_ADMIN_PHONE=
AUTH_COOKIE_DOMAIN=.travelstrem.com
WHATSAPP_CHANNEL_NAME=Trevio
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbDvRFaKQuJCtvIAQr0D
BASE_URL=https://api.travelstrem.com
FRONTENDS=["https://trevio.travelstrem.com","https://trevista.travelstrem.com","https://dashboard.travelstrem.com","https://booking.travelstrem.com","https://auth.travelstrem.com","https://admin.travelstrem.com","https://www.travelstrem.com","https://travelstrem.com"]

# --- MongoDB -----------------------------------------------------------------
# Example: mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=

# --- JWT / Auth --------------------------------------------------------------
JWT_ACCESS_SECRET=                    # Generate a long random string (openssl rand -hex 64)
JWT_REFRESH_SECRET=                   # Generate a different long random string
ACCESS_TOKEN_EXPIRES_IN=15m           # Access token lifetime
REFRESH_TOKEN_EXPIRES_IN=30d          # Refresh token lifetime (default: 30d)
ADMIN_CREATION_SECRET=                # Secret used to verify admin account creation

# --- Cloudinary (image upload) -----------------------------------------------
CLOUDINARY_NAME=                      # Cloudinary cloud name
CLOUDINARY_KEY=                       # Cloudinary API key
CLOUDINARY_SECRET=                    # Cloudinary API secret

# --- Data protection / cache -------------------------------------------------
PII_ENCRYPTION_KEY=
REDIS_URL=

# --- SMTP (email) ------------------------------------------------------------
# Leave empty if email is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@travelstrem.com

# --- OAuth (social login) ----------------------------------------------------
# Full authorize URLs (including client_id, redirect_uri, etc.)
OAUTH_GOOGLE_URL=
OAUTH_GITHUB_URL=
OAUTH_APPLE_URL=

# --- Webhooks ----------------------------------------------------------------
AGENT_WEBHOOK_URL=                    # Zapier / automation webhook for form submissions

# --- Features ----------------------------------------------------------------
ENABLE_EMAILS=false                   # Toggle email sending (requires SMTP)
ENABLE_DEBUG_LOGS=false               # Enable verbose debug logging
OTP_TTL_MS=900000
RATE_WINDOW_MS=60000
RATE_MAX=60
DEV_DELAY_MS=0
