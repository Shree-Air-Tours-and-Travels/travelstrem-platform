# =============================================================================
# Production environment , set each value before deploying
# Copy to your server and fill in the real secrets
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=production
BASE_URL=https://your-domain.com
FRONTENDS=https://your-frontend-domain.com

# --- MongoDB -----------------------------------------------------------------
# Example: mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGO_URI=

# --- JWT / Auth --------------------------------------------------------------
JWT_ACCESS_SECRET=                    # Generate a long random string (openssl rand -hex 64)
JWT_REFRESH_SECRET=                   # Generate a different long random string
JWT_EXPIRES_IN=15m                    # Access token lifetime (default: 15m)
REFRESH_TOKEN_EXPIRES_IN=30d          # Refresh token lifetime (default: 30d)
ADMIN_CREATION_SECRET=                # Secret used to verify admin account creation

# --- Cloudinary (image upload) -----------------------------------------------
CLOUDINARY_NAME=                      # Cloudinary cloud name
CLOUDINARY_KEY=                       # Cloudinary API key
CLOUDINARY_SECRET=                    # Cloudinary API secret

# --- SMTP (email) ------------------------------------------------------------
# Leave empty if email is not configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# --- OAuth (social login) ----------------------------------------------------
# Full authorize URLs (including client_id, redirect_uri, etc.)
OAUTH_GOOGLE_URL=
OAUTH_GITHUB_URL=
OAUTH_APPLE_URL=

# --- Webhooks ----------------------------------------------------------------
AGENT_WEBHOOK_URL=                    # Zapier / automation webhook for form submissions

# --- Features ----------------------------------------------------------------
ENABLE_EMAILS=false                   # Toggle email sending (requires SMTP)
ENABLE_DEBUG_LOGS=false               # Enable verbose debug logging
