{
  "name": "@apps/backend-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development USE_DOTENV=true nodemon src/server.js",
    "build": "node --check src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests"
    ,"seed:tenancy": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/seedTenancy.js"
    ,"migrate:tenancy": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateTenancy.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.6.0",
    "nodemon": "^3.1.10"
  }
}
