{
  "name": "@apps/backend-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development USE_DOTENV=true nodemon src/server.js",
    "build": "node --check src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --passWithNoTests",
    "migrate:tenancy": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateTenancy.js",
    "migrate:tour-search": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateTourSearch.js",
    "migrate:tour-search-index": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateTourSearchIndex.js",
    "migrate:travel-catalog": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/backfillTravelCatalog.js --apply",
    "migrate:booking-quote-indexes": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateBookingQuoteIndexes.js",
    "migrate:authentication": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateAuthentication.js",
    "migrate:financial-engine-indexes": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateFinancialEngineIndexes.js",
    "migrate:tour-commercial-pricing": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/migrateTourCommercialPricing.js",
    "audit:empty-database": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/clearOperationalData.js",
    "reset:empty-database": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/clearOperationalData.js --apply",
    "reset:travel-catalog": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/resetTravelCatalog.js",
    "seed:master-customizable-tour": "cross-env NODE_ENV=development USE_DOTENV=true node src/scripts/seedMasterCustomizableTour.js",
    "master-data:export": "cross-env USE_DOTENV=true node src/scripts/exportMasterData.js",
    "master-data:import": "cross-env USE_DOTENV=true node src/scripts/importMasterData.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@packages/trem-process-engine": "workspace:*",
    "@packages/trem-support-contracts": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^11.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.10",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.18.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.6.0",
    "nodemon": "^3.1.10"
  }
}
