              { "name": "cardHolderName", "labelRef": "cardHolderName", "type": "text", "required": true },
              { "name": "expiryDate", "labelRef": "expiryDate", "type": "text", "required": true },
              { "name": "cvv", "labelRef": "cvv", "type": "password", "required": true }
