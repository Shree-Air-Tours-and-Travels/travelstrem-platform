{
  "version": "1.0.0",
  "defaultPage": "customer-shell/home",
  "pages": {
    "customer-shell/home": {
      "app": "customer-shell",
      "page": "home",
      "file": "./customer-shell/home/page.json"
    },
    "customer-shell/checkout": {
      "app": "customer-shell",
      "page": "checkout",
      "file": "./customer-shell/checkout/page.json"
    },
    "customer-shell/dashboard": {
      "app": "customer-shell",
      "page": "dashboard",
      "file": "./customer-shell/dashboard/page.json"
    },
    "tours-remote/listing": {
      "app": "tours-remote",
      "page": "listing",
      "file": "./tours-remote/listing/page.json"
    },
    "tours-remote/details": {
      "app": "tours-remote",
      "page": "details",
      "file": "./tours-remote/details/page.json"
    },
    "tours-remote/booking-summary": {
      "app": "tours-remote",
      "page": "booking-summary",
      "file": "./tours-remote/booking-summary/page.json"
    },
    "tours-remote/booking-checkout": {
      "app": "tours-remote",
      "page": "booking-checkout",
      "file": "./tours-remote/booking-checkout/page.json"
    },
    "admin-shell/dashboard": {
      "app": "admin-shell",
      "page": "dashboard",
      "file": "./admin-shell/dashboard/page.json"
    },
    "admin-shell/bookings": {
      "app": "admin-shell",
      "page": "bookings",
      "file": "./admin-shell/bookings/page.json"
    }
  },
  "pathMap": {
    "/": "customer-shell/home",
    "/dashboard": "customer-shell/dashboard",
    "/checkout": "customer-shell/checkout",
    "/admin": "admin-shell/dashboard",
    "/admin/bookings": "admin-shell/bookings"
  },
  "aliases": {
    "home": "customer-shell/home",
    "customer-dashboard": "customer-shell/dashboard",
    "checkout": "customer-shell/checkout",
    "tour-listing": "tours-remote/listing",
    "tour-details": "tours-remote/details",
    "dashboard": "admin-shell/dashboard",
    "bookings": "admin-shell/bookings"
  }
}
