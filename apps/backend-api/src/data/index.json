{
  "version": "1.0.0",
  "defaultPage": "trevio-remote/home",
  "pages": {
    "app-shell/app-shell": {
      "app": "app-shell",
      "page": "app-shell",
      "file": "./app-shell/app-shell/page.json"
    },
    "app-shell/articles": {
      "app": "app-shell",
      "page": "articles",
      "file": "./app-shell/articles/page.json"
    },
    "tours-remote/listing": {
      "app": "tours-remote",
      "page": "listing",
      "file": "./tours-remote/listing/page.json"
    },
    "tours-remote/details": {
      "app": "tours-remote",
      "page": "details",
      "file": "./tours-remote/details/page.json"
    },
    "trevio-remote/home": {
      "app": "trevio-remote",
      "page": "home",
      "file": "./trevio-remote/home/page.json"
    },
    "trevista-remote/home": {
      "app": "trevista-remote",
      "page": "home",
      "file": "./trevista-remote/home/page.json"
    },
    "trehub-remote/home": {
      "app": "trehub-remote",
      "page": "home",
      "file": "./trehub-remote/home/page.json"
    },
    "trehub-remote/flights/flight-list": {
      "app": "trehub-remote",
      "page": "flight-list",
      "file": "./trehub-remote/flights/page.json"
    },
    "trehub-remote/hotels/hotels": {
      "app": "trehub-remote",
      "page": "hotels",
      "file": "./trehub-remote/hotels/hotels.json"
    },
    "trehub-remote/flights/flight-journey": {
      "app": "trehub-remote",
      "page": "flight-journey",
      "file": "./trehub-remote/flights/flight-journey.json"
    },
    "admin-shell/dashboard": {
      "app": "admin-shell",
      "page": "dashboard",
      "file": "./admin-shell/dashboard/page.json"
    },
    "admin-shell/pricing": {
      "app": "admin-shell",
      "page": "pricing",
      "file": "./admin-shell/pricing/page.json"
    },
    "agent-shell/services": {
      "app": "agent-shell",
      "page": "services",
      "file": "./agent-shell/services/page.json"
    },
    "agent-shell/dashboard": {
      "app": "agent-shell",
      "page": "dashboard",
      "file": "./agent-shell/dashboard/page.json"
    },
    "agent-shell/agency": {
      "app": "agent-shell",
      "page": "agency",
      "file": "./agent-shell/agency/page.json"
    }
  },
  "pathMap": {
    "/": "trevio-remote/home",
    "/app-shell": "app-shell/app-shell",
    "/articles": "app-shell/articles",
    "/trevista": "tours-remote/listing",
    "/trevista/:tourRef": "tours-remote/details",
    "/trevista/home": "trevista-remote/home",
    "/trevio": "trevio-remote/home",
    "/trehub": "trehub-remote/home",
    "/trehub/flights": "trehub-remote/flights/flight-list",
    "/trehub/flights/:offerId": "trehub-remote/flights/flight-journey",
    "/trehub/hotels": "trehub-remote/hotels/hotels",
    "/trehub/hotels/:hotelId": "trehub-remote/hotels/hotels",
    "/admin": "admin-shell/dashboard",
    "/admin/pricing": "admin-shell/pricing",
    "/agent/services": "agent-shell/services",
    "/agent/dashboard": "agent-shell/dashboard",
    "/agent/agency": "agent-shell/agency"
  },
  "aliases": {
    "home": "trevio-remote/home",
    "articles": "app-shell/articles",
    "tour-listing": "tours-remote/listing",
    "tour-details": "tours-remote/details",
    "trevio": "trevio-remote/home",
    "trehub": "trehub-remote/home",
    "trehub-flights": "trehub-remote/flights/flight-list",
    "trehub-flight-journey": "trehub-remote/flights/flight-journey",
    "dashboard": "admin-shell/dashboard",
    "admin-pricing": "admin-shell/pricing",
    "agent-services": "agent-shell/services",
    "agent-dashboard": "agent-shell/dashboard",
    "agent-agency": "agent-shell/agency"
  }
}
