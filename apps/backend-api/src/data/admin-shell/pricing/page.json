        "saveError": "Pricing configuration could not be saved"
      },
      "urls": {}
    },
    "structure": {
      "header": {
        "eyebrowRef": "heroEyebrow",
        "titleRef": "heroTitle",
        "descriptionRef": "heroDescription",
        "accessLabelRef": "masterAdminOnly",
        "accessIcon": "shieldCheck"
      },
      "widgets": [
        {
          "type": "PricingEditor",
          "props": {
            "eyebrowRef": "configurationTarget",
            "createTitleRef": "createPricingRules",
            "editTitleRef": "editVersion",
            "versionRef": "version",
            "newScopeRef": "newScope",
            "recordTone": "info",
            "newTone": "neutral",
            "scopeFields": [
              { "name": "scopeType", "component": "select", "labelRef": "applyPricingBy", "optionsRef": "scopeTypes", "maxHeight": 320 },
              {
                "name": "scopeId",
                "component": "input",
                "labelRef": "scopeIdentifier",
                "placeholderRef": "scopeIdentifierPlaceholder",
                "disabledWhen": { "field": "scopeType", "equals": "GLOBAL" },
                "hintRefsByValue": {
                  "PRODUCT": "scopeProductHint",
                  "PAYMENT_PROVIDER": "scopePaymentProviderHint",
                  "PAYMENT_METHOD": "scopePaymentMethodHint",
                  "CURRENCY": "scopeCurrencyHint",
                  "COUNTRY": "scopeCountryHint",
                  "CUSTOMER_TYPE": "scopeCustomerTypeHint",
                  "AGENCY": "scopeAgencyHint",
                  "TOUR": "scopeTourHint",
                  "BOOKING": "scopeBookingHint"
                }
              }
            ],
            "sections": [
              {
                "id": "platformFee",
                "icon": "wallet",
                "titleRef": "platformFeeTitle",
                "descriptionRef": "platformFeeDescription",
                "toggle": { "name": "tremFeeEnabled", "labelRef": "collectPlatformFee", "descriptionRef": "collectPlatformFeeDescription" },
                "fields": [
                  { "name": "tremFeeType", "component": "select", "labelRef": "feeType", "optionsRef": "feeTypes", "disabledWhen": { "field": "tremFeeEnabled", "equals": false } },
                  {
                    "name": "tremFeeValue",
                    "component": "input",
                    "inputMode": "decimal",
                    "labelRefByValue": { "field": "tremFeeType", "map": { "fixed": "feeAmount", "percentage": "feePercentage" } },
                    "placeholderRefByValue": { "field": "tremFeeType", "map": { "fixed": "moneyPlaceholder", "percentage": "percentagePlaceholder" } },
                    "disabledWhen": { "field": "tremFeeEnabled", "equals": false }
                  },
                  { "name": "tremFeeGstRate", "component": "input", "inputMode": "decimal", "labelRef": "platformFeeGst", "placeholderRef": "percentagePlaceholder", "disabledWhen": { "field": "tremFeeEnabled", "equals": false } },
                  { "name": "currency", "component": "input", "labelRef": "currency", "maxLength": 3 }
                ]
              },
              {
                "id": "gateway",
                "icon": "payment",
                "titleRef": "gatewayTitle",
                "descriptionRef": "gatewayDescription",
                "toggle": { "name": "gatewayEnabled", "labelRef": "recoverGatewayCharges", "descriptionRef": "recoverGatewayChargesDescription" },
                "columns": 2,
                "fields": [
                  { "name": "gatewayRate", "component": "input", "inputMode": "decimal", "labelRef": "gatewayRate", "placeholderRef": "percentagePlaceholder", "disabledWhen": { "field": "gatewayEnabled", "equals": false } },
                  { "name": "gatewayGstRate", "component": "input", "inputMode": "decimal", "labelRef": "gatewayGst", "placeholderRef": "percentagePlaceholder", "disabledWhen": { "field": "gatewayEnabled", "equals": false } }
                ]
              },
              {
                "id": "activation",
                "icon": "calendar",
                "titleRef": "activationTitle",
                "descriptionRef": "activationDescription",
                "toggle": { "name": "active", "labelRef": "configurationActive", "descriptionRef": "configurationActiveDescription" },
                "columns": 2,
                "fields": [
                  { "name": "effectiveFrom", "component": "input", "variant": "datetime-local", "labelRef": "effectiveFrom" },
                  { "name": "effectiveUntil", "component": "input", "variant": "datetime-local", "labelRef": "effectiveUntil" }
                ]
              }
            ],
            "footerNoteRef": "immutableVersionNote",
            "footerIcon": "info",
            "actionId": "publish"
          }
        },
        {
          "type": "PricingHistory",
          "props": {
            "eyebrowRef": "auditTrail",
            "titleRef": "pricingVersions",
            "emptyTitleRef": "emptyTitle",
            "emptyDescriptionRef": "emptyDescription",
            "emptyIcon": "wallet",
            "scopeOptionsRef": "scopeTypes",
            "refreshActionId": "refresh",
            "versionRef": "versionLabel",
            "effectiveRef": "effective",
            "immediatelyRef": "immediately",
            "activeRef": "active",
            "inactiveRef": "inactive",
            "activeTone": "success",
            "inactiveTone": "neutral",
            "dateFormat": { "dateStyle": "medium", "timeStyle": "short" },
            "enabledRef": "enabled",
            "disabledRef": "disabled",
            "summaryItems": [
              { "labelRef": "tremFeeSummary", "path": "editor.tremFeeEnabled" },
              { "labelRef": "gatewaySummary", "path": "editor.gatewayEnabled" }
            ],
            "recordActionId": "useVersion"
          }
        }
      ],
      "config": {
        "access": { "adminLevels": ["master"] },
        "defaults": {
          "scopeType": "GLOBAL",
          "scopeId": "default",
          "active": true,
          "effectiveFrom": "",
          "effectiveUntil": "",
          "rules": {
            "currency": "INR",
            "tremFeeEnabled": false,
            "tremFeeType": "fixed",
            "tremFeeValue": "0",
            "tremFeeGstRate": "0",
            "gatewayEnabled": false,
            "gatewayRate": "0",
            "gatewayGstRate": "0"
          }
        },
        "globalScope": { "type": "GLOBAL", "id": "default" },
        "toggleStateRefs": {
          "enabled": "enabled",
          "disabled": "disabled",
          "enabledIcon": "check",
          "disabledIcon": "minus"
        },
        "payload": {
          "scopeTypeField": "scopeType",
          "scopeIdField": "scopeId",
          "activeField": "active",
          "effectiveFromField": "effectiveFrom",
          "effectiveUntilField": "effectiveUntil",
          "ruleFields": [
            "currency",
            "tremFeeEnabled",
            "tremFeeType",
            "tremFeeValue",
            "tremFeeGstRate",
            "gatewayEnabled",
            "gatewayRate",
            "gatewayGstRate"
          ]
        },
        "messages": { "loadingRef": "loading", "scopeRequiredRef": "scopeRequired", "loadErrorRef": "loadError", "saveErrorRef": "saveError" }
      },
      "actions": [
        { "id": "publish", "labelRef": "publish", "loadingLabelRef": "publishing", "icon": "shieldCheck", "type": "submit" },
        { "id": "refresh", "labelRef": "refresh", "icon": "refreshCw", "variant": "secondary" },
        { "id": "useVersion", "labelRef": "useAsNextVersion", "icon": "chevronRight", "variant": "text" }
      ]
    }
  }
}
