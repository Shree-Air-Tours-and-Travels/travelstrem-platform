              },
              { "id": "productLabel", "labelRef": "tableHeaderProduct", "type": "badge", "toneAccessor": "product", "minWidth": 120 },
              { "id": "status", "labelRef": "tableHeaderStatus", "type": "status", "secondaryAccessor": "paymentStatus", "minWidth": 170 },
              { "id": "travelDates", "labelRef": "tableHeaderTravelDates", "minWidth": 210 },
              { "id": "travellers", "labelRef": "tableHeaderTravellers", "minWidth": 140 },
