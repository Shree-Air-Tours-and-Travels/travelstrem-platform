                "titleAccessor": "tour",
                "subtitleAccessor": "tremId",
                "imageAccessor": "image",
                "badgeAccessor": "status",
                "fieldIds": ["productLabel", "travelDates", "travellers", "price", "createdAt"],
                "actionLabelRef": "viewBookingAction"
