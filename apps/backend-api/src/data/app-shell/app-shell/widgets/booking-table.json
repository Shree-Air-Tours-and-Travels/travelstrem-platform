              },
              "filters": [
                {
                  "id": "product",
                  "labelRef": "product",
                  "accessor": "product",
                  "optionsKey": "productOptions"
                },
                {
                  "id": "status",
                  "labelRef": "status",
                  "accessor": "status",
                  "optionsKey": "statusOptions"
                }
              ]
            },
            "sortingHeader": {
              "labelRef": "sortBy",
              "selectLabelRef": "sortBy",
              "defaultValue": "newest",
              "optionsKey": "sortOptions"
            },
            "pagination": {
              "serverSide": false,
              "pageSizeOptions": [10, 20, 50],
              "pageSize": 10,
              "pageSizeLabel": "Rows per page"
            },
            "columns": [
              { "id": "tremId", "labelRef": "tableHeaderId", "minWidth": 150, "emphasis": "danger", "clickable": true, "action": "viewBooking", "actionLabelRef": "viewBookingAction" },
              {
                "id": "tour",
                "labelRef": "tableHeaderTour",
                "type": "mediaText",
                "minWidth": 310,
                "titleAccessor": "tour",
