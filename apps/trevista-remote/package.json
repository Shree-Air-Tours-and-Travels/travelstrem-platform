{
  "name": "@apps/trevista",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@packages/trem-auth-core": "workspace:*",
    "@packages/trem-modals": "workspace:*",
    "@packages/trem-environment": "workspace:*",
    "@packages/trem-events": "workspace:*",
    "@packages/trem-runtime": "workspace:*",
    "@packages/trem-session": "workspace:*",
    "@packages/trem-ui": "workspace:*",
    "@packages/trem-utils": "workspace:*",
    "@packages/trem-widget-contracts": "workspace:*",
    "ajv": "^8.20.0",
    "axios": "^1.8.4",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
    "react-scripts": "5.0.1",
    "sass": "^1.86.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "cross-env": "^7.0.3"
  },
  "scripts": {
    "prebuild": "node ../../scripts/sync-favicons.mjs trevista-remote",
    "dev": "cross-env PUBLIC_URL=/ PORT=3001 DISABLE_ESLINT_PLUGIN=true craco start",
    "start": "cross-env PUBLIC_URL=/ PORT=3001 DISABLE_ESLINT_PLUGIN=true craco start",
    "build": "cross-env PUBLIC_URL=/ DISABLE_ESLINT_PLUGIN=true craco build",
    "test": "craco test --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
