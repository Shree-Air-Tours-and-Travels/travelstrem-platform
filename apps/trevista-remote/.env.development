# Vercel/frontend build variables for Trevista Remote
PORT=3001
REACT_APP_PORTAL_ENV=development
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_REALTIME_ENABLED=true
REACT_APP_REALTIME_URL=http://localhost:5000
REACT_APP_REALTIME_PATH=/socket.io
REACT_APP_AUTH_APP_URL=http://localhost:3003
REACT_APP_SHELL_URL=http://localhost:3006
REACT_APP_ADMIN_SHELL_URL=http://localhost:3002
REACT_APP_ABOUT_URL=https://travelstrem.com/about
REACT_APP_THEME_COOKIE_DOMAIN=

# Keep false in Vercel unless you intentionally need runtime-like local overrides.
REACT_APP_ALLOW_ENV_OVERRIDES=true
