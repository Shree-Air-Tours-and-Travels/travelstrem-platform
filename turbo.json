{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "11",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", "storybook-static/**"]
    },
    "test": {},
    "clean": {
      "cache": false
    }
  }
}
